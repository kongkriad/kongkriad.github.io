---
const navItems = [
  { name: "Home", href: "/" },
  { name: "About", href: "about" },
  { name: "Projects", href: "projects" },
  { name: "Contact", href: "contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-gray-950/80 backdrop-blur-md border-b border-gray-800">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight hover:text-blue-400 transition">
      kongkriad Protfolio
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm text-gray-300 hover:text-white transition"
        >
          {item.name}
        </a>
      ))}
    </nav>
  </div>
</header>