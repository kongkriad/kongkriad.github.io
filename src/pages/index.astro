---

<Layout>
	<Header/>
	<main class="container">
		<div class="my-5 space-content">
			<div class="astro-BBE6DXRZ hero my-24">
				<div class="astro-BBE6DXRZ container">
					<div class="astro-BBE6DXRZ flex items-center gap-24 justify-center">
						<div class="astro-BBE6DXRZ flex flex-col items-center md:items-start gap-8">
							<h1 astro-BBE6DXRZ md:text-left text-center>
								<span astro-BBE6DXRZ text-gradient>kongkriad samwong</span>
								<div class="astro-BBE6DXRZ lg:text-7xl text-6xl">
									<span class="astro-BBE6DXRZ hidden md:block text-sm">👇👇 Nick Name</span>
									tets
								</div>
							</h1>
						</div>
					</div>

				</div>

			</div>

		</div>
		<h1>
			test
		</h1>
	</main>
	<Footer/>
</Layout>
